#:import dp kivy.metrics.dp

<ColorDot>:
    size_hint: None, None
    size: dp(34), dp(34)
    radius: [dp(17), dp(17), dp(17), dp(17)]
    elevation: 0
    md_bg_color: app.hex_to_rgba(root.color_hex)
    line_color: (1, 1, 1, 1) if root.color_hex == root.selected_color else (0, 0, 0, 0)
    line_width: dp(2)

<SubjectRow>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(72)
    padding: dp(16), dp(12)
    spacing: dp(12)
    radius: [dp(20), dp(20), dp(20), dp(20)]
    elevation: 0
    md_bg_color: 0.105, 0.09, 0.16, 1

    MDCard:
        size_hint: None, None
        size: dp(18), dp(18)
        radius: [dp(9), dp(9), dp(9), dp(9)]
        elevation: 0
        md_bg_color: app.hex_to_rgba(root.subject_color)
        pos_hint: {"center_y": .5}

    MDLabel:
        text: root.subject_name
        bold: True
        theme_text_color: "Custom"
        text_color: 0.96, 0.94, 1, 1
        shorten: True
        shorten_from: "right"

    MDIconButton:
        icon: "palette-outline"
        theme_icon_color: "Custom"
        icon_color: app.hex_to_rgba(root.subject_color)
        on_release: app.root.ids.screen_manager.get_screen("subjects").cycle_subject_color(root.subject_id)

    MDLabel:
        text: app.t("default", app.translation_version) if root.is_default else ""
        size_hint_x: None
        width: dp(72) if root.is_default else 0
        font_style: "Caption"
        halign: "center"
        theme_text_color: "Custom"
        text_color: 0.72, 0.68, 0.84, 1

    MDIconButton:
        icon: "delete-outline"
        opacity: 0 if root.is_default else 1
        disabled: root.is_default
        theme_icon_color: "Custom"
        icon_color: 0.95, 0.38, 0.46, 1
        on_release: app.root.ids.screen_manager.get_screen("subjects").delete_subject(root.subject_id)

<SubjectsScreen>:
    md_bg_color: 0.055, 0.047, 0.09, 1

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: app.t("subjects", app.translation_version)
            elevation: 0
            md_bg_color: 0.055, 0.047, 0.09, 1
            specific_text_color: 0.96, 0.94, 1, 1
            left_action_items: [["menu", lambda x: app.toggle_navigation_drawer()]]

        ScrollView:
            do_scroll_x: False
            bar_width: 0

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(18), dp(12), dp(18), dp(30)
                spacing: dp(18)

                MDLabel:
                    text: app.t("manage_subjects", app.translation_version)
                    font_style: "H5"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: 0.96, 0.94, 1, 1
                    adaptive_height: True

                MDLabel:
                    text: app.t("subjects_description", app.translation_version)
                    theme_text_color: "Custom"
                    text_color: 0.68, 0.65, 0.78, 1
                    adaptive_height: True

                MDCard:
                    orientation: "vertical"
                    adaptive_height: True
                    padding: dp(18)
                    spacing: dp(14)
                    radius: [dp(26), dp(26), dp(26), dp(26)]
                    elevation: 0
                    md_bg_color: 0.105, 0.09, 0.16, 1

                    MDLabel:
                        text: app.t("new_subject", app.translation_version)
                        font_style: "H6"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: 0.96, 0.94, 1, 1
                        adaptive_height: True

                    MDTextField:
                        id: subject_name
                        hint_text: app.t("subject_name_example", app.translation_version)
                        mode: "rectangle"
                        multiline: False
                        on_text_validate: root.add_subject()

                    MDLabel:
                        text: app.t("select_color", app.translation_version)
                        bold: True
                        theme_text_color: "Custom"
                        text_color: 0.72, 0.68, 0.84, 1
                        adaptive_height: True

                    MDGridLayout:
                        cols: 4
                        adaptive_height: True
                        spacing: dp(12)

                        ColorDot:
                            color_hex: "#A78BFA"
                            selected_color: root.selected_color

                        ColorDot:
                            color_hex: "#F472B6"
                            selected_color: root.selected_color

                        ColorDot:
                            color_hex: "#60A5FA"
                            selected_color: root.selected_color

                        ColorDot:
                            color_hex: "#34D399"
                            selected_color: root.selected_color

                        ColorDot:
                            color_hex: "#FBBF24"
                            selected_color: root.selected_color

                        ColorDot:
                            color_hex: "#FB7185"
                            selected_color: root.selected_color

                        ColorDot:
                            color_hex: "#22D3EE"
                            selected_color: root.selected_color

                        ColorDot:
                            color_hex: "#C084FC"
                            selected_color: root.selected_color

                    MDRaisedButton:
                        text: app.t("add_subject", app.translation_version)
                        size_hint_x: 1
                        md_bg_color: app.hex_to_rgba(root.selected_color)
                        on_release: root.add_subject()

                    MDLabel:
                        text: root.status_text
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: 0.95, 0.66, 0.35, 1
                        adaptive_height: True

                MDLabel:
                    text: app.t("subjects", app.translation_version)
                    font_style: "H6"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: 0.96, 0.94, 1, 1
                    adaptive_height: True

                MDBoxLayout:
                    id: subjects_list
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(10)