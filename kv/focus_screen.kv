#:import dp kivy.metrics.dp

<FocusScreen>:
    md_bg_color: app.theme_colors["bg"]

    FloatLayout:

        # =====================================================
        # ANA FOCUS EKRANI
        # =====================================================

        MDBoxLayout:
            orientation: "vertical"
            size_hint: 1, 1
            pos_hint: {"x": 0, "y": 0}

            MDTopAppBar:
                anchor_title: "center"
                elevation: 0
                md_bg_color: app.theme_colors["bg"]
                specific_text_color: app.theme_colors["text"]

                left_action_items:
                    [["menu", lambda x: app.toggle_navigation_drawer()]]

                right_action_items:
                    [["cog-outline", lambda x: root.open_settings()]]

            MDBoxLayout:
                orientation: "vertical"
                padding: dp(18), dp(12), dp(18), dp(24)
                spacing: dp(8)

                MDLabel:
                    text: app.t("focus_timer", app.translation_version)
                    halign: "center"
                    font_style: "H5"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: app.theme_colors["text"]
                    size_hint_y: None
                    height: dp(34)

                MDLabel:
                    text: app.t("focus_subtitle", app.translation_version)
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: app.theme_colors["muted"]
                    size_hint_y: None
                    height: dp(30)

                Widget:
                    size_hint_y: 0.15

                MDCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(475)
                    padding: dp(18), dp(20), dp(18), dp(20)
                    spacing: dp(10)
                    radius: [dp(30), dp(30), dp(30), dp(30)]
                    elevation: 0
                    md_bg_color: app.theme_colors["card"]

                    MDLabel:
                        text: str(root.active_task_name)
                        halign: "center"
                        valign: "middle"
                        font_style: "H6"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: app.theme_colors["primary"]
                        size_hint_y: None
                        height: dp(46)
                        text_size: self.width - dp(20), None

                    MDBoxLayout:
                        orientation: "vertical"
                        size_hint_y: None
                        height: dp(220)
                        spacing: dp(2)

                        Widget:
                            size_hint_y: 0.3

                        MDLabel:
                            text: str(root.timer_text)
                            halign: "center"
                            font_style: "H2"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["text"]

                        MDLabel:
                            text: str(root.status_text)
                            halign: "center"
                            font_style: "Subtitle1"
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["muted"]
                            size_hint_y: None
                            height: dp(34)

                        MDRaisedButton:
                            text: app.t("stop_alarm", app.translation_version)
                            size_hint_x: 1
                            size_hint_y: None

                            height: dp(48) if app.alarm_active else 0
                            opacity: 1 if app.alarm_active else 0
                            disabled: not app.alarm_active

                            md_bg_color: app.theme_colors["red"]

                            on_release:
                                app.stop_alarm()

                        Widget:
                            size_hint_y: 0.3

                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(76)
                        spacing: dp(16)
                        padding: dp(10), 0

                        Widget:

                        MDFloatingActionButton:
                            icon: "restore"
                            type: "small"
                            md_bg_color: app.theme_colors["card_soft"]
                            on_release: root.reset_timer()

                        MDFloatingActionButton:
                            icon: root.primary_action_icon
                            type: "large"
                            md_bg_color: app.theme_colors["primary"]
                            on_release: root.toggle_timer()

                        MDFloatingActionButton:
                            icon: "stop"
                            type: "small"
                            md_bg_color: app.theme_colors["card_soft"]
                            on_release: root.finish_session()

                        Widget:

                    MDCard:
                        orientation: "horizontal"
                        size_hint_y: None

                        height:
                            dp(72) if root.setting_show_away_time else 0

                        opacity:
                            1 if root.setting_show_away_time else 0

                        disabled:
                            not root.setting_show_away_time

                        padding: dp(16), dp(10)
                        radius: [dp(18), dp(18), dp(18), dp(18)]
                        elevation: 0
                        md_bg_color: app.theme_colors["card_soft"]

                        MDBoxLayout:
                            orientation: "vertical"

                            MDLabel:
                                text: app.t("away_time", app.translation_version)
                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]

                            MDLabel:
                                text: str(root.away_time_text)
                                font_style: "H6"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["orange"]

                        MDIcon:
                            icon: "timer-sand"
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["orange"]
                            size_hint_x: None
                            width: dp(42)

                Widget:
                    size_hint_y: 0.85

        # =====================================================
        # PANEL AÇIKKEN ARKA PLANI KARARTAN KATMAN
        # =====================================================

        Button:
            size_hint:
                (1, 1) if root.settings_panel_open else (None, None)

            size:
                root.size if root.settings_panel_open else (0, 0)

            pos: 0, 0

            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0.48

            opacity:
                1 if root.settings_panel_open else 0

            disabled:
                not root.settings_panel_open

            on_release:
                root.close_settings()

        # =====================================================
        # SAĞDAN AÇILAN FOCUS AYAR PANELİ
        # =====================================================

        MDBoxLayout:
            id: focus_settings_panel
            orientation: "vertical"
            size_hint: None, 1

            width: min(root.width * 0.86, dp(370))
            x: root.width - self.width if root.settings_panel_open else root.width
            y: 0

            padding: dp(18), dp(16), dp(18), dp(24)
            spacing: dp(14)

            disabled: not root.settings_panel_open
            opacity: 1 if root.settings_panel_open else 0

            canvas.before:
                Color:
                    rgba: app.sidebar_color

                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(26), 0, 0, dp(26)]

            MDBoxLayout:
                size_hint_y: None
                height: dp(48)
                spacing: dp(8)

                MDLabel:
                    text: app.t("focus_settings", app.translation_version)
                    font_style: "Subtitle1"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: app.theme_colors["text"]

                MDIconButton:
                    icon: "close"
                    theme_icon_color: "Custom"
                    icon_color: app.theme_colors["soft"]
                    on_release: root.close_settings()

            MDLabel:
                text: app.t("focus_settings_description", app.translation_version)
                font_style: "Caption"
                theme_text_color: "Custom"
                text_color: app.theme_colors["muted"]
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width, None

            ScrollView:
                do_scroll_x: False
                bar_width: 0

                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(18)
                    padding: 0, dp(10), 0, dp(18)

                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(10)

                        MDBoxLayout:
                            orientation: "vertical"
                            adaptive_height: True
                            size_hint_x: 1
                            padding: 0, dp(2), dp(8), dp(2)

                            MDLabel:
                                text: app.t("auto_start_break", app.translation_version)
                                font_style: "Subtitle2"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["text"]
                                adaptive_height: True
                                text_size: self.width, None

                            MDLabel:
                                text: app.t("auto_start_break_description", app.translation_version)
                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]
                                adaptive_height: True
                                text_size: self.width, None

                        AnchorLayout:
                            size_hint_x: None
                            width: dp(58)
                            padding: 0, 0, dp(36), 0
                            anchor_x: "center"
                            anchor_y: "center"

                            NagomiSwitch:
                                state: "down" if root.setting_auto_start_break else "normal"

                                on_state:
                                    root.setting_auto_start_break = self.state == "down"
                                    
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(10)

                        MDBoxLayout:
                            orientation: "vertical"
                            adaptive_height: True
                            size_hint_x: 1
                            padding: 0, dp(2), dp(8), dp(2)

                            MDLabel:
                                text: app.t("auto_start_focus", app.translation_version)
                                font_style: "Subtitle2"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["text"]
                                adaptive_height: True
                                text_size: self.width, None

                            MDLabel:
                                text: app.t("auto_start_focus_description", app.translation_version)
                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]
                                adaptive_height: True
                                text_size: self.width, None

                        AnchorLayout:
                            size_hint_x: None
                            width: dp(58)
                            padding: 0, 0, dp(36), 0
                            anchor_x: "center"
                            anchor_y: "center"

                            NagomiSwitch:
                                state: "down" if root.setting_auto_start_focus else "normal"

                                on_state:
                                    root.setting_auto_start_focus = self.state == "down"


                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(10)
                        padding: 0, dp(12), 0, 0

                        MDLabel:
                            text: app.t("show_away_time", app.translation_version)
                            font_style: "Subtitle2"
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["text"]
                            adaptive_height: True
                            text_size: self.width, None
                            size_hint_x: 1

                        AnchorLayout:
                            size_hint_x: None
                            width: dp(58)
                            padding: 0, 0, dp(36), 0
                            anchor_x: "center"
                            anchor_y: "center"

                            NagomiSwitch:
                                state: "down" if root.setting_show_away_time else "normal"
                                on_state:
                                    root.setting_show_away_time = self.state == "down"

                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(10)
                        padding: 0, dp(12), 0, 0

                        MDLabel:
                            text: app.t("show_queue_progress", app.translation_version)
                            font_style: "Subtitle2"
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["text"]
                            adaptive_height: True
                            text_size: self.width, None
                            size_hint_x: 1

                        AnchorLayout:
                            size_hint_x: None
                            width: dp(58)
                            padding: 0, 0, dp(36), 0
                            anchor_x: "center"
                            anchor_y: "center"

                            NagomiSwitch:
                                state: "down" if root.setting_show_queue_progress else "normal"
                                on_state:
                                    root.setting_show_queue_progress = self.state == "down"

            MDRaisedButton:
                text: app.t("save", app.translation_version)
                size_hint_x: 1
                size_hint_y: None
                height: dp(50)
                md_bg_color: app.theme_colors["primary"]
                on_release: root.save_focus_settings()
