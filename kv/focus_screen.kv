#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<FocusScreen>:
    md_bg_color: app.theme_colors["bg"]

    FloatLayout:

        # =====================================================
        # ANA FOCUS EKRANI
        # =====================================================

        MDBoxLayout:
            orientation: "vertical"
            size_hint: 1, 1
            pos_hint: {"x": 0, "y": 0}

            MDTopAppBar:
                title: app.t("focus_timer", app.translation_version) if app.layout_profile == "tablet_landscape" else ""
                anchor_title: "center"
                elevation: 0
                md_bg_color: app.theme_colors["bg"]
                specific_text_color: app.theme_colors["text"]

                left_action_items:
                    [["menu", lambda x: app.toggle_navigation_drawer()]]

                right_action_items:
                    [["cog-outline", lambda x: root.open_settings()]]

            MDBoxLayout:
                orientation: "vertical"
                padding: dp(18), dp(app.responsive(12, 12, 12, 12, 0)), dp(18), dp(24)
                spacing: dp(app.responsive(8, 8, 6, 8, 0))

                MDLabel:
                    text: app.t("focus_timer", app.translation_version)
                    halign: "center"
                    valign: "top"
                    font_size: sp(app.typography("page_title", app.layout_profile))
                    bold: True
                    theme_text_color: "Custom"
                    text_color: app.theme_colors["text"]
                    size_hint_y: None
                    height: 0 if app.layout_profile == "tablet_landscape" else (0 if not app.is_landscape else dp(34))
                    opacity: 0 if app.layout_profile == "tablet_landscape" else (0 if not app.is_landscape else 1)

                MDLabel:
                    text: app.t("focus_subtitle", app.translation_version)
                    halign: "center"
                    theme_text_color: "Custom"
                    font_size: sp(app.typography("body_small", app.layout_profile))
                    text_color: app.theme_colors["muted"]
                    size_hint_y: None
                    height: 0 if app.layout_profile == "tablet_landscape" else (0 if not app.is_landscape else dp(30))
                    opacity: 0 if app.layout_profile == "tablet_landscape" else (0 if not app.is_landscape else 1)

                Widget:
                    size_hint_y: None
                    height: 0 if not app.is_landscape else dp(app.responsive(8, 16, 6, 24, 0))

                MDCard:
                    orientation: "vertical"

                    size_hint_y: None if not app.is_landscape else 1
                    height: 0 if not app.is_landscape else dp(app.responsive(390, 440, 330, 560, 500))

                    opacity: 0 if not app.is_landscape else 1
                    disabled: not app.is_landscape
                    padding: dp(app.responsive(12, 18, 10, 24, 20)), dp(app.responsive(14, 20, 10, 26, 22))
                    spacing: dp(10)
                    radius: [dp(30), dp(30), dp(30), dp(30)]
                    elevation: 0
                    md_bg_color: app.theme_colors["card"]

                    Widget:
                        size_hint_y: None
                        height: dp(app.responsive(8, 10, 8, 18, 28))

                    MDLabel:
                        text: str(root.active_task_name)
                        halign: "center"
                        valign: "bottom"
                        font_size: sp(app.typography("section_title", app.layout_profile))
                        bold: True
                        theme_text_color: "Custom"
                        text_color: app.theme_colors["primary"]
                        size_hint_y: None
                        height: dp(46)
                        text_size: self.width - dp(20), self.height

                    MDBoxLayout:
                        orientation: "vertical"
                        size_hint: None, None
                        width: dp(app.responsive(220, 280, 210, 420, 360))
                        height: dp(app.responsive(120, 150, 110, 220, 120))
                        spacing: dp(app.responsive(4, 6, 3, 10, 4))
                        pos_hint: {"center_x": 0.5}

                        MDLabel:
                            text: str(root.timer_text)
                            halign: "center"
                            font_size: sp(app.typography("timer", app.layout_profile))
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["text"]
                            size_hint_y: None
                            height: dp(app.responsive(60, 70, 60, 90, 70))

                        MDLabel:
                            text: str(root.status_text)
                            halign: "center"
                            font_size: sp(app.typography("body_small", app.layout_profile))
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["muted"]
                            size_hint_y: None
                            height: dp(34)


                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(app.responsive(58, 70, 54, 90, 82))
                        spacing: dp(app.responsive(8, 14, 6, 20, 16))
                        padding: dp(10), 0

                        Widget:

                        MDFloatingActionButton:
                            icon: "restore"
                            type: "small"
                            md_bg_color: app.theme_colors["card_soft"]
                            on_release: root.reset_timer()

                        MDFloatingActionButton:
                            icon: root.primary_action_icon
                            type: "standard" if app.is_phone else "large"
                            md_bg_color: app.theme_colors["primary"]
                            on_release: root.toggle_timer()

                        MDFloatingActionButton:
                            icon: "stop"
                            type: "small"
                            md_bg_color: app.theme_colors["card_soft"]
                            on_release: root.finish_session()

                        Widget:

                    AnchorLayout:
                        size_hint_y: None
                        height: dp(app.responsive(42, 48, 40, 58, 52)) if app.alarm_active else 0
                        anchor_x: "center"
                        anchor_y: "center"

                        opacity: 1 if app.alarm_active else 0
                        disabled: not app.alarm_active

                        MDFillRoundFlatButton:
                            text: app.t("stop_alarm", app.translation_version)
                            size_hint: None, None
                            width: dp(app.responsive(120, 140, 115, 210, 170))
                            height: dp(app.responsive(36, 40, 34, 48, 42))

                            font_size: sp(app.typography("body_small", app.layout_profile))
                            md_bg_color: app.theme_colors["red"]
                            text_color: 1, 1, 1, 1

                            on_release: app.stop_alarm()

                    Widget:
                        size_hint_y: 1 if app.layout_profile == "tablet_portrait" else 0.15

                    MDCard:
                        orientation: "horizontal"
                        size_hint_y: None

                        height: dp(app.responsive(64, 72, 58, 86, 78)) if root.setting_show_away_time else 0

                        opacity:
                            1 if root.setting_show_away_time else 0

                        disabled:
                            not root.setting_show_away_time

                        padding: dp(16), dp(10)
                        radius: [dp(18), dp(18), dp(18), dp(18)]
                        elevation: 0
                        md_bg_color: app.theme_colors["card_soft"]

                        MDBoxLayout:
                            orientation: "vertical"

                            MDLabel:
                                text: app.t("away_time", app.translation_version)
                                font_size: sp(app.typography("caption", app.layout_profile))
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]

                            MDLabel:
                                text: str(root.away_time_text)
                                font_size: sp(app.typography("section_title", app.layout_profile))
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["orange"]

                        MDIcon:
                            icon: "timer-sand"
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["orange"]
                            size_hint_x: None
                            width: dp(42)
                            pos_hint: {"center_y": 0.56}

                MDCard:
                    orientation: "horizontal"

                    size_hint_y: 1 if not app.is_landscape else None
                    height: dp(1) if not app.is_landscape else 0

                    opacity: 1 if not app.is_landscape else 0
                    disabled: app.layout_profile != "phone_landscape"

                    padding: dp(18), dp(12)
                    spacing: dp(16)

                    radius: [dp(24), dp(24), dp(24), dp(24)]
                    elevation: 0
                    md_bg_color: app.theme_colors["card"]

                    MDBoxLayout:
                        orientation: "vertical"
                        size_hint_x: 1
                        spacing: dp(6)

                        MDLabel:
                            text: str(root.active_task_name)
                            halign: "center"
                            valign: "middle"
                            bold: True
                            font_size: sp(app.typography("section_title", app.layout_profile))
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["primary"]
                            size_hint_y: None
                            height: dp(30)
                            text_size: self.width, self.height

                        Widget:

                        MDLabel:
                            text: str(root.timer_text)
                            halign: "center"
                            bold: True
                            font_size: sp(app.typography("timer", app.layout_profile))
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["text"]
                            size_hint_y: None
                            height: dp(70)

                        MDLabel:
                            text: str(root.status_text)
                            halign: "center"
                            font_size: sp(app.typography("body_small", app.layout_profile))
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["muted"]
                            size_hint_y: None
                            height: dp(26)

                        Widget:

                    AnchorLayout:
                        size_hint_x: None
                        width: dp(130)
                        anchor_x: "center"
                        anchor_y: "center"

                        MDFillRoundFlatButton:
                            text: app.t("stop_alarm", app.translation_version)
                            size_hint: None, None
                            width: dp(118)
                            height: dp(38)

                            opacity: 1 if app.alarm_active else 0
                            disabled: not app.alarm_active

                            font_size: sp(app.typography("caption", app.layout_profile))
                            md_bg_color: app.theme_colors["red"]
                            text_color: 1, 1, 1, 1

                            on_release: app.stop_alarm()

                    AnchorLayout:
                        size_hint_x: None
                        width: dp(120)
                        anchor_x: "center"
                        anchor_y: "center"

                        MDBoxLayout:
                            orientation: "vertical"
                            size_hint: None, None
                            width: dp(78)
                            height: dp(190)
                            spacing: dp(10)

                            MDFloatingActionButton:
                                icon: "restore"
                                type: "small"
                                pos_hint: {"center_x": 0.5}
                                md_bg_color: app.theme_colors["card_soft"]
                                on_release: root.reset_timer()

                            MDFloatingActionButton:
                                icon: root.primary_action_icon
                                type: "standard"
                                pos_hint: {"center_x": 0.5}
                                md_bg_color: app.theme_colors["primary"]
                                on_release: root.toggle_timer()

                            MDFloatingActionButton:
                                icon: "stop"
                                type: "small"
                                pos_hint: {"center_x": 0.5}
                                md_bg_color: app.theme_colors["card_soft"]
                                on_release: root.finish_session()

        # =====================================================
        # PANEL AÇIKKEN ARKA PLANI KARARTAN KATMAN
        # =====================================================

        Button:
            size_hint:
                (1, 1) if root.settings_panel_open else (None, None)

            size:
                root.size if root.settings_panel_open else (0, 0)

            pos: 0, 0

            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0.48

            opacity:
                1 if root.settings_panel_open else 0

            disabled:
                not root.settings_panel_open

            on_release:
                root.close_settings()

        # =====================================================
        # SAĞDAN AÇILAN FOCUS AYAR PANELİ
        # =====================================================

        MDBoxLayout:
            id: focus_settings_panel
            orientation: "vertical"
            size_hint: None, 1

            width: min(root.width * 0.86, dp(370))
            x: root.width - self.width if root.settings_panel_open else root.width
            y: 0

            padding: dp(18), dp(16), dp(18), dp(24)
            spacing: dp(14)

            disabled: not root.settings_panel_open
            opacity: 1 if root.settings_panel_open else 0

            canvas.before:
                Color:
                    rgba: app.sidebar_color

                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(26), 0, 0, dp(26)]

            MDBoxLayout:
                size_hint_y: None
                height: dp(48)
                spacing: dp(8)

                MDLabel:
                    text: app.t("focus_settings", app.translation_version)
                    font_size: sp(app.typography("section_title", app.layout_profile))
                    bold: True
                    theme_text_color: "Custom"
                    text_color: app.theme_colors["text"]

                MDIconButton:
                    icon: "close"
                    theme_icon_color: "Custom"
                    icon_color: app.theme_colors["soft"]
                    on_release: root.close_settings()

            MDLabel:
                text: app.t("focus_settings_description", app.translation_version)
                font_size: sp(app.typography("body_small", app.layout_profile))
                theme_text_color: "Custom"
                text_color: app.theme_colors["muted"]
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width, None

            ScrollView:
                do_scroll_x: False
                bar_width: 0

                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(18)
                    padding: 0, dp(10), 0, dp(18)

                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(10)

                        MDBoxLayout:
                            orientation: "vertical"
                            adaptive_height: True
                            size_hint_x: 1
                            padding: 0, dp(2), dp(8), dp(2)

                            MDLabel:
                                text: app.t("auto_start_break", app.translation_version)
                                font_size: sp(app.typography("body", app.layout_profile))
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["text"]
                                adaptive_height: True
                                text_size: self.width, None

                            MDLabel:
                                text: app.t("auto_start_break_description", app.translation_version)
                                font_size: sp(app.typography("caption", app.layout_profile))
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]
                                adaptive_height: True
                                text_size: self.width, None

                        AnchorLayout:
                            size_hint_x: None
                            width: dp(58)
                            padding: 0, 0, dp(36), 0
                            anchor_x: "center"
                            anchor_y: "center"

                            NagomiSwitch:
                                size_hint: None, None
                                size: dp(app.responsive(52, 58, 48, 68, 62)), dp(app.responsive(28, 32, 26, 38, 34))
                                
                                state: "down" if root.setting_auto_start_break else "normal"

                                on_state:
                                    root.setting_auto_start_break = self.state == "down"
                                    
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(10)

                        MDBoxLayout:
                            orientation: "vertical"
                            adaptive_height: True
                            size_hint_x: 1
                            padding: 0, dp(2), dp(8), dp(2)

                            MDLabel:
                                text: app.t("auto_start_focus", app.translation_version)
                                font_size: sp(app.typography("body", app.layout_profile))
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["text"]
                                adaptive_height: True
                                text_size: self.width, None

                            MDLabel:
                                text: app.t("auto_start_focus_description", app.translation_version)
                                font_size: sp(app.typography("caption", app.layout_profile))
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]
                                adaptive_height: True
                                text_size: self.width, None

                        AnchorLayout:
                            size_hint_x: None
                            width: dp(58)
                            padding: 0, 0, dp(36), 0
                            anchor_x: "center"
                            anchor_y: "center"

                            NagomiSwitch:
                                size_hint: None, None
                                size: dp(app.responsive(52, 58, 48, 68, 62)), dp(app.responsive(28, 32, 26, 38, 34))

                                state: "down" if root.setting_auto_start_focus else "normal"

                                on_state:
                                    root.setting_auto_start_focus = self.state == "down"


                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(10)
                        padding: 0, dp(12), 0, 0

                        MDLabel:
                            text: app.t("show_away_time", app.translation_version)
                            font_size: sp(app.typography("body", app.layout_profile))
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["text"]
                            adaptive_height: True
                            text_size: self.width, None
                            size_hint_x: 1

                        AnchorLayout:
                            size_hint_x: None
                            width: dp(58)
                            padding: 0, 0, dp(36), 0
                            anchor_x: "center"
                            anchor_y: "center"

                            NagomiSwitch:
                                size_hint: None, None
                                size: dp(app.responsive(52, 58, 48, 68, 62)), dp(app.responsive(28, 32, 26, 38, 34))

                                disabled: not app.is_landscape

                                state:
                                    "normal" if not app.is_landscape else \
                                    ("down" if root.setting_show_away_time else "normal")

                                on_state:
                                    if app.layout_profile != "phone_landscape": \
                                    root.set_away_time_setting(self.state == "down")

            MDRaisedButton:
                text: app.t("save", app.translation_version)
                font_size: sp(app.typography("body", app.layout_profile))
                size_hint_x: 1
                size_hint_y: None
                height: dp(50)
                md_bg_color: app.theme_colors["primary"]
                on_release: root.save_focus_settings()
