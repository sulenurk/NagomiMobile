#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<DarkSpinner@Spinner>:
    background_normal: ""
    background_down: ""
    background_color: app.theme_colors["surface_light"]

    color: app.theme_colors["text"]
    font_size: sp(15)

    size_hint_y: None
    height: dp(48)

    padding: dp(14), 0

<SpinnerOption>:
    background_normal: ""
    background_down: ""
    background_color: app.theme_colors["card"]
    color: app.theme_colors["text"]
    font_size: sp(15)
    height: dp(46)

<TaskRow>:
    orientation: "vertical"
    adaptive_height: True
    padding: dp(16)
    spacing: dp(10)
    radius: [dp(22), dp(22), dp(22), dp(22)]
    elevation: 0
    md_bg_color: app.theme_colors["card"]
    line_color: app.hex_to_rgba(root.subject_color) if root.is_active else (0, 0, 0, 0)
    line_width: dp(2)

    MDBoxLayout:
        adaptive_height: True
        spacing: dp(10)

        MDCard:
            size_hint: None, None
            size: dp(18), dp(18)
            radius: [dp(9), dp(9), dp(9), dp(9)]
            elevation: 0
            md_bg_color: app.hex_to_rgba(root.subject_color)

        MDLabel:
            text: root.subject_name
            bold: True
            theme_text_color: "Custom"
            text_color: app.hex_to_rgba(root.subject_color)
            adaptive_height: True

        MDLabel:
            text: root.status_text
            halign: "right"
            theme_text_color: "Custom"
            text_color: app.theme_colors["muted"]
            adaptive_height: True

    MDLabel:
        text: root.title
        font_style: "H6"
        bold: True
        theme_text_color: "Custom"
        text_color: app.theme_colors["muted"] if root.is_completed else app.theme_colors["text"]
        adaptive_height: True

    MDLabel:
        text: root.detail_text + "  •  " + root.priority_text
        theme_text_color: "Custom"
        text_color: app.theme_colors["muted"]
        adaptive_height: True

    MDBoxLayout:
        adaptive_height: True
        spacing: dp(4)

        MDIconButton:
            icon: "play-outline"
            disabled: root.is_completed or root.is_active
            opacity: 0.35 if self.disabled else 1
            on_release: app.root.ids.screen_manager.get_screen("study").start_task(root.task_id)

        MDIconButton:
            icon: "check-circle-outline" if not root.is_completed else "backup-restore"
            on_release: app.root.ids.screen_manager.get_screen("study").toggle_complete(root.task_id)

        MDIconButton:
            icon: "content-copy"
            disabled: root.is_completed
            opacity: 0.35 if self.disabled else 1
            on_release: app.root.ids.screen_manager.get_screen("study").duplicate_task(root.task_id)

        MDIconButton:
            icon: "pencil-outline"
            on_release: app.root.ids.screen_manager.get_screen("study").edit_task(root.task_id)

        MDIconButton:
            icon: "arrow-up"
            disabled: root.index == 0 or root.is_completed
            opacity: 0.35 if self.disabled else 1
            on_release: app.root.ids.screen_manager.get_screen("study").move_task(root.task_id, -1)

        MDIconButton:
            icon: "arrow-down"
            disabled: root.index >= root.total - 1 or root.is_completed
            opacity: 0.35 if self.disabled else 1
            on_release: app.root.ids.screen_manager.get_screen("study").move_task(root.task_id, 1)

        Widget:

        MDIconButton:
            icon: "delete-outline"
            theme_icon_color: "Custom"
            icon_color: app.theme_colors["red"]
            on_release: app.root.ids.screen_manager.get_screen("study").delete_task(root.task_id)

<StudyPlanScreen>:
    md_bg_color: app.theme_colors["bg"]

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: app.t("study_plan", app.translation_version)
            elevation: 0
            md_bg_color: app.theme_colors["bg"]
            specific_text_color: app.theme_colors["text"]
            left_action_items: [["menu", lambda x: app.toggle_navigation_drawer()]]
            right_action_items: [["play", lambda x: root.start_plan()]]

        ScrollView:
            do_scroll_x: False
            bar_width: 0

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(18), dp(12), dp(18), dp(30)
                spacing: dp(16)

                MDLabel:
                    text: app.t("daily_study_plan", app.translation_version)
                    font_style: "H5"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: app.theme_colors["bg"]
                    adaptive_height: True

                MDLabel:
                    text: root.summary_text
                    theme_text_color: "Custom"
                    text_color: app.theme_colors["muted"]
                    adaptive_height: True

                MDCard:
                    orientation: "vertical"
                    adaptive_height: True
                    padding: dp(16), dp(18), dp(16), dp(18)
                    spacing: dp(16)
                    radius: [dp(24), dp(24), dp(24), dp(24)]
                    elevation: 0
                    md_bg_color: app.theme_colors["card"]

                    MDLabel:
                        text: app.t("add_task", app.translation_version) if not root.editing_task_id else app.t("edit_task", app.translation_version)
                        font_style: "H6"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: app.theme_colors["text"]
                        adaptive_height: True

                    DarkSpinner:
                        id: subject_spinner
                        text: root.selected_subject_name
                        values: []
                        on_text: root.selected_subject_name = self.text

                    MDTextField:
                        id: task_title
                        hint_text: app.t("task_name", app.translation_version)
                        mode: "fill"
                        multiline: False

                        size_hint_y: None
                        height: dp(64)

                        fill_color_normal: app.theme_colors["input"]
                        fill_color_focus: app.theme_colors["input"]

                        text_color_normal: app.theme_colors["input_text"]
                        text_color_focus: app.theme_colors["input_text"]

                        hint_text_color_normal: app.theme_colors["muted"]
                        hint_text_color_focus: app.theme_colors["primary"]

                        helper_text_color_normal: app.theme_colors["muted"]
                        helper_text_color_focus: app.theme_colors["primary"]

                        line_color_normal: 0, 0, 0, 0
                        line_color_focus: app.theme_colors["primary"]

                        on_text_validate: root.add_or_update_task()

                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(10)

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(72)
                            spacing: dp(10)

                            MDTextField:
                                id: focus_duration
                                text: "25"
                                hint_text: app.t("focus_duration", app.translation_version)
                                helper_text: app.t("minutes", app.translation_version)
                                helper_text_mode: "persistent"
                                mode: "fill"
                                input_filter: "int"

                                size_hint_y: None
                                height: dp(68)

                                fill_color_normal: app.theme_colors["input"]
                                fill_color_focus: app.theme_colors["input"]

                                text_color_normal: app.theme_colors["input_text"]
                                text_color_focus: app.theme_colors["input_text"]

                                hint_text_color_normal: app.theme_colors["muted"]
                                hint_text_color_focus: app.theme_colors["primary"]

                                helper_text_color_normal: app.theme_colors["muted"]
                                helper_text_color_focus: app.theme_colors["primary"]

                                line_color_normal: 0, 0, 0, 0
                                line_color_focus: app.theme_colors["primary"]

                            MDTextField:
                                id: break_minutes
                                text: "5"
                                hint_text: app.t("break_minutes", app.translation_version)
                                helper_text: app.t("minutes", app.translation_version)
                                helper_text_mode: "persistent"
                                mode: "fill"
                                input_filter: "int"

                                size_hint_y: None
                                height: dp(68)

                                fill_color_normal: app.theme_colors["input"]
                                fill_color_focus: app.theme_colors["input"]

                                text_color_normal: app.theme_colors["input_text"]
                                text_color_focus: app.theme_colors["input_text"]

                                hint_text_color_normal: app.theme_colors["muted"]
                                hint_text_color_focus: app.theme_colors["primary"]

                                helper_text_color_normal: app.theme_colors["muted"]
                                helper_text_color_focus: app.theme_colors["primary"]

                                line_color_normal: 0, 0, 0, 0
                                line_color_focus: app.theme_colors["primary"]
                    DarkSpinner:
                        id: priority_spinner
                        text: app.t(root.selected_priority, app.translation_version)
                        values: [app.t("low", app.translation_version), app.t("medium", app.translation_version), app.t("high", app.translation_version)]
                        size_hint_y: None
                        height: dp(46)
                        on_text: root.change_priority(self.text)

                    MDBoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(54)
                        spacing: dp(10)

                        MDFlatButton:
                            text: app.t("cancel", app.translation_version)
                            size_hint_x: 0.35
                            height: dp(48)
                            opacity: 1 if root.editing_task_id else 0
                            disabled: not root.editing_task_id
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["muted"]
                            on_release: root.cancel_edit()

                        MDRaisedButton:
                            text: app.t("save", app.translation_version)
                            size_hint_x: 0.65 if root.editing_task_id else 1
                            height: dp(48)
                            md_bg_color: app.theme_colors["primary"]
                            on_release: root.add_or_update_task()

                    MDLabel:
                        text: root.form_status
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: app.theme_colors["orange"]
                        adaptive_height: True

                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(6)

                    MDFlatButton:
                        text: app.t("all", app.translation_version)
                        on_release: root.set_filter("all")
                    MDFlatButton:
                        text: app.t("pending", app.translation_version)
                        on_release: root.set_filter("pending")
                    MDFlatButton:
                        text: app.t("active", app.translation_version)
                        on_release: root.set_filter("active")
                    MDFlatButton:
                        text: app.t("completed", app.translation_version)
                        on_release: root.set_filter("completed")

                MDLabel:
                    id: empty_label
                    text: app.t("no_tasks_yet", app.translation_version)
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: app.theme_colors["text"]
                    adaptive_height: True

                MDBoxLayout:
                    id: task_list
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(10)
