#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<SettingsScreen>:
    md_bg_color: app.theme_colors["bg"]

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: app.t("settings", app.translation_version)
            anchor_title: "center"
            elevation: 0
            md_bg_color: app.theme_colors["bg"]
            specific_text_color: app.theme_colors["text"]

            left_action_items:
                [["menu", lambda x: app.toggle_navigation_drawer()]]
            right_action_items: [["blank", lambda x: None]]

        ScrollView:
            do_scroll_x: False
            bar_width: 0

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(18), dp(14), dp(18), dp(32)
                spacing: dp(14)

                # -------------------------------------------------
                # OTOMATİK BAŞLATMA
                # -------------------------------------------------

                MDCard:
                    orientation: "vertical"
                    adaptive_height: True
                    padding: dp(16)
                    spacing: dp(14)
                    radius: [dp(24), dp(24), dp(24), dp(24)]
                    elevation: 0
                    md_bg_color: app.theme_colors["card"]

                    MDLabel:
                        text: app.t("auto_start", app.translation_version)
                        font_size: sp(app.typography("section_title", app.layout_profile))
                        bold: True
                        theme_text_color: "Custom"
                        text_color: app.theme_colors["text"]
                        adaptive_height: True

                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(12)

                        MDBoxLayout:
                            adaptive_height: True
                            spacing: dp(10)

                            MDBoxLayout:
                                orientation: "vertical"
                                adaptive_height: True
                                size_hint_x: 1
                                padding: 0, dp(2), dp(8), dp(2)

                                MDLabel:
                                    text: app.t("auto_start_focus_sessions", app.translation_version)
                                    font_size: sp(app.typography("body", app.layout_profile))
                                    bold: True
                                    theme_text_color: "Custom"
                                    text_color: app.theme_colors["text"]
                                    adaptive_height: True
                                    text_size: self.width, None

                                MDLabel:
                                    text: app.t("auto_start_focus_sessions_description", app.translation_version)
                                    font_size: sp(app.typography("caption", app.layout_profile))
                                    theme_text_color: "Custom"
                                    text_color: app.theme_colors["muted"]
                                    adaptive_height: True
                                    text_size: self.width, None

                            AnchorLayout:
                                size_hint_x: None
                                width: dp(68)
                                padding: 0, 0, dp(12), 0
                                anchor_x: "center"
                                anchor_y: "center"

                                NagomiSwitch:
                                    size_hint: None, None
                                    size: dp(app.responsive(52, 58, 48, 68, 62)), dp(app.responsive(28, 32, 26, 38, 34))
                                    state: "down" if root.auto_start_focus else "normal"
                                    on_state: root.set_auto_start_focus(self.state == "down")
                                    

                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(12)

                        MDBoxLayout:
                            orientation: "vertical"
                            adaptive_height: True
                            size_hint_x: 1
                            padding: 0, dp(2), dp(8), dp(2)

                            MDLabel:
                                text: app.t("auto_start_breaks", app.translation_version)
                                font_size: sp(app.typography("body", app.layout_profile))
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["text"]
                                adaptive_height: True

                            MDLabel:
                                text: app.t("auto_start_breaks_description", app.translation_version)
                                font_size: sp(app.typography("caption", app.layout_profile))
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]
                                adaptive_height: True

                        AnchorLayout:
                            size_hint_x: None
                            width: dp(68)
                            padding: 0, 0, dp(12), 0
                            anchor_x: "center"
                            anchor_y: "center"

                            NagomiSwitch:
                                size_hint: None, None
                                size: dp(app.responsive(52, 58, 48, 68, 62)), dp(app.responsive(28, 32, 26, 38, 34))
                                state: "down" if root.auto_start_break else "normal"
                                on_state: root.set_auto_start_break(self.state == "down")
                                
                # -------------------------------------------------
                # SES
                # -------------------------------------------------

                MDCard:
                    orientation: "vertical"
                    adaptive_height: True
                    padding: dp(16)
                    spacing: dp(16)
                    radius: [dp(24), dp(24), dp(24), dp(24)]
                    elevation: 0
                    md_bg_color: app.theme_colors["card"]

                    # Ses aç / kapat
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(12)

                        MDBoxLayout:
                            orientation: "vertical"
                            adaptive_height: True

                            MDLabel:
                                text: app.t("sound_notifications", app.translation_version)
                                font_size: sp(app.typography("section_title", app.layout_profile))
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["text"]
                                adaptive_height: True

                            MDLabel:
                                text: app.t("sound_notifications_description", app.translation_version)
                                font_size: sp(app.typography("caption", app.layout_profile))
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]
                                adaptive_height: True
                                text_size: self.width, None

                        AnchorLayout:
                            size_hint_x: None
                            width: dp(68)
                            padding: 0, 0, dp(12), 0
                            anchor_x: "center"
                            anchor_y: "center"

                            NagomiSwitch:
                                size_hint: None, None
                                size: dp(app.responsive(52, 58, 48, 68, 62)), dp(app.responsive(28, 32, 26, 38, 34))
                                state: "down" if root.sound_enabled else "normal"
                                on_release: root.set_sound_enabled(self.state == "down")

                    MDSeparator:
                        size_hint_y: None
                        height: dp(1)
                        color: app.theme_colors["card_border"]

                    # Titreşim aç / kapat
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(12)

                        MDBoxLayout:
                            orientation: "vertical"
                            adaptive_height: True

                            MDLabel:
                                text: app.t("vibration", app.translation_version)
                                font_size: sp(app.typography("body", app.layout_profile))
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["text"]
                                adaptive_height: True

                            MDLabel:
                                text: app.t("vibration_description", app.translation_version)
                                font_size: sp(app.typography("caption", app.layout_profile))
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]
                                adaptive_height: True
                                text_size: self.width, None

                        AnchorLayout:
                            size_hint_x: None
                            width: dp(68)
                            padding: 0, 0, dp(12), 0
                            anchor_x: "center"
                            anchor_y: "center"

                            NagomiSwitch:
                                size_hint: None, None
                                size: dp(app.responsive(52, 58, 48, 68, 62)), dp(app.responsive(28, 32, 26, 38, 34))
                                state: "down" if root.vibration_enabled else "normal"
                                on_release: root.set_vibration_enabled(self.state == "down")
        
                    # Alarm tonu seçimi
                    MDBoxLayout:
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(8)

                        MDLabel:
                            text: app.t("alarm_tone", app.translation_version)
                            font_size: sp(app.typography("body", app.layout_profile))
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["text"]
                            adaptive_height: True

                        MDLabel:
                            text: app.t("alarm_tone_description", app.translation_version)
                            font_size: sp(app.typography("caption", app.layout_profile))
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["muted"]
                            adaptive_height: True
                            text_size: self.width, None

                        DarkSpinner:
                            id: alarm_sound_spinner
                            text: root.selected_alarm_name
                            values: root.alarm_display_values

                            disabled: not root.sound_enabled
                            opacity: 1 if root.sound_enabled else 0.45

                            on_text: root.set_alarm_sound_by_name(self.text)
               
                # -------------------------------------------------
                # GÖRÜNÜM VE RENK PALETİ
                # -------------------------------------------------

                MDCard:
                    orientation: "vertical"
                    adaptive_height: True
                    padding: dp(16)
                    spacing: dp(14)
                    radius: [dp(24), dp(24), dp(24), dp(24)]
                    elevation: 0
                    md_bg_color: app.theme_colors["card"]

                    MDLabel:
                        text: app.t("appearance", app.translation_version)
                        font_size: sp(app.typography("section_title", app.layout_profile))
                        bold: True
                        theme_text_color: "Custom"
                        text_color: app.theme_colors["text"]
                        adaptive_height: True

                    MDLabel:
                        text: app.t("color_palette_description", app.translation_version)
                        font_size: sp(app.typography("caption", app.layout_profile))
                        theme_text_color: "Custom"
                        text_color: app.theme_colors["muted"]
                        adaptive_height: True
                        text_size: self.width, None

                    DarkSpinner:
                        id: color_palette_spinner
                        text: app.selected_palette_name
                        values: app.palette_display_values

                        on_text:
                            app.set_color_palette_by_name(self.text)

                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(8)

                        MDLabel:
                            text: app.t("palette_preview", app.translation_version)
                            font_size: sp(app.typography("caption", app.layout_profile))
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["muted"]
                            adaptive_height: True

                        Widget:

                        MDCard:
                            size_hint: None, None
                            size: dp(24), dp(24)
                            radius: [dp(12), dp(12), dp(12), dp(12)]
                            elevation: 0
                            md_bg_color: app.theme_colors["primary"] if app.theme_version >= 0 else (1, 1, 1, 1)

                        MDCard:
                            size_hint: None, None
                            size: dp(24), dp(24)
                            radius: [dp(12), dp(12), dp(12), dp(12)]
                            elevation: 0
                            md_bg_color: app.theme_colors["primary_soft"] if app.theme_version >= 0 else (1, 1, 1, 1)

                        MDCard:
                            size_hint: None, None
                            size: dp(24), dp(24)
                            radius: [dp(12), dp(12), dp(12), dp(12)]
                            elevation: 0
                            md_bg_color: app.theme_colors["card_soft"] if app.theme_version >= 0 else (1, 1, 1, 1)

                # -------------------------------------------------
                # HEDEF VE GÖRÜNÜRLÜK
                # -------------------------------------------------

                MDCard:
                    orientation: "vertical"
                    adaptive_height: True
                    padding: dp(16)
                    spacing: dp(14)
                    radius: [dp(24), dp(24), dp(24), dp(24)]
                    elevation: 0
                    md_bg_color: app.theme_colors["card"]

                    MDLabel:
                        text: app.t("plan_and_statistics", app.translation_version)
                        font_size: sp(app.typography("section_title", app.layout_profile))
                        bold: True
                        theme_text_color: "Custom"
                        text_color: app.theme_colors["text"]
                        adaptive_height: True

                    MDTextField:
                        id: daily_goal
                        text: root.daily_goal_text
                        hint_text: app.t("daily_focus_goal", app.translation_version)
                        font_size: sp(app.typography("input", app.layout_profile))
                        input_filter: "int"
                        mode: "fill"
                        size_hint_y: None
                        height: dp(68)

                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(12)
                        padding: 0, dp(14), dp(8), dp(2)

                        MDLabel:
                            text: app.t("show_queue_progress", app.translation_version)
                            font_size: sp(app.typography("body", app.layout_profile))
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["text"]
                            adaptive_height: True

                        AnchorLayout:
                            size_hint_x: None
                            width: dp(68)
                            padding: 0, 0, dp(12), 0
                            anchor_x: "center"
                            anchor_y: "center"

                            NagomiSwitch:
                                size_hint: None, None
                                size: dp(app.responsive(52, 58, 48, 68, 62)), dp(app.responsive(28, 32, 26, 38, 34))
                                state: "down" if root.show_queue_progress else "normal"
                                on_state: root.set_show_queue_progress(self.state == "down")
                                
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(12)
                        padding: 0, dp(12), dp(8), dp(2)

                        MDLabel:
                            text: app.t("show_total_away_time", app.translation_version)
                            font_size: sp(app.typography("body", app.layout_profile))
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["text"]
                            adaptive_height: True

                        AnchorLayout:
                            size_hint_x: None
                            width: dp(68)
                            padding: 0, 0, dp(12), 0
                            anchor_x: "center"
                            anchor_y: "center"

                            NagomiSwitch:
                                size_hint: None, None
                                size: dp(app.responsive(52, 58, 48, 68, 62)), dp(app.responsive(28, 32, 26, 38, 34))
                                state: "down" if root.show_cumulative_away_time else "normal"
                                on_state: root.set_show_cumulative_away_time(self.state == "down")
                                
                    MDBoxLayout:
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(6)
                        padding: 0, dp(10), 0, 0

                        MDLabel:
                            text: app.t("first_day_of_week", app.translation_version)
                            font_size: sp(app.typography("body", app.layout_profile))
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["text"]
                            adaptive_height: True

                        MDLabel:
                            text: app.t("first_day_of_week_description", app.translation_version)
                            font_size: sp(app.typography("caption", app.layout_profile))
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["muted"]
                            adaptive_height: True

                        DarkSpinner:
                            id: week_start_spinner
                            text: root.week_start_text
                            values: [app.t("monday", app.translation_version), app.t("sunday", app.translation_version)]
                            on_text: root.change_week_start(self.text)

                MDRaisedButton:
                    text: app.t("save", app.translation_version)
                    font_size: sp(app.typography("body", app.layout_profile))
                    size_hint_x: 1
                    height: dp(50)
                    md_bg_color: app.theme_colors["primary"]
                    on_release: root.save_numeric_settings()

                MDFlatButton:
                    text: app.t("reset_settings", app.translation_version)
                    font_size: sp(app.typography("body", app.layout_profile))
                    size_hint_x: 1
                    height: dp(48)
                    theme_text_color: "Custom"
                    text_color: app.theme_colors["red"]
                    on_release: root.reset_settings()

                MDLabel:
                    text: root.status_text
                    font_size: sp(app.typography("status", app.layout_profile))
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: app.theme_colors["orange"]
                    adaptive_height: True