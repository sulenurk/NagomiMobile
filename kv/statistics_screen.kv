#:import dp kivy.metrics.dp

<StatisticsScreen>:
    md_bg_color: app.theme_colors["bg"]

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: app.t("statistics", app.translation_version)
            anchor_title: "center"
            elevation: 0
            md_bg_color: app.theme_colors["bg"]
            specific_text_color: app.theme_colors["text"]

            left_action_items:
                [["menu", lambda x: app.toggle_navigation_drawer()]]

        ScrollView:
            do_scroll_x: False
            bar_width: 0

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(18), dp(14), dp(18), dp(32)
                spacing: dp(14)

                MDLabel:
                    text: app.t("statistics", app.translation_version)
                    font_style: "Subtitle1"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: app.theme_colors["text"]
                    adaptive_height: True

                MDLabel:
                    text: app.t("statistics_subtitle" , app.translation_version)
                    font_style: "Subtitle2"
                    theme_text_color: "Custom"
                    text_color: app.theme_colors["muted"]
                    adaptive_height: True

                # -----------------------------------------------
                # BUGÜNÜN METRİKLERİ
                # -----------------------------------------------

                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(8)

                    MDCard:
                        orientation: "vertical"
                        adaptive_height: True
                        padding: dp(12)
                        spacing: dp(4)
                        radius: [dp(18), dp(18), dp(18), dp(18)]
                        elevation: 0
                        md_bg_color: app.theme_colors["card"]

                        MDLabel:
                            text: app.t("today", app.translation_version)
                            font_style: "Caption"
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["muted"]
                            adaptive_height: True

                        MDLabel:
                            text: root.today_focus_text
                            font_style: "H6"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["green"]
                            adaptive_height: True

                    MDCard:
                        orientation: "vertical"
                        adaptive_height: True
                        padding: dp(12)
                        spacing: dp(4)
                        radius: [dp(18), dp(18), dp(18), dp(18)]
                        elevation: 0
                        md_bg_color: app.theme_colors["card"]

                        MDLabel:
                            text: app.t("sessions", app.translation_version)
                            font_style: "Caption"
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["muted"]
                            adaptive_height: True

                        MDLabel:
                            text: root.completed_sessions_text
                            font_style: "H6"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["primary"]
                            adaptive_height: True

                    MDCard:
                        orientation: "vertical"
                        adaptive_height: True
                        padding: dp(12)
                        spacing: dp(4)
                        radius: [dp(18), dp(18), dp(18), dp(18)]
                        elevation: 0
                        md_bg_color: app.theme_colors["card"]

                        MDLabel:
                            text: app.t("away", app.translation_version)
                            font_style: "Caption"
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["muted"]
                            adaptive_height: True

                        MDLabel:
                            text: root.away_time_text
                            font_style: "H6"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["orange"]
                            adaptive_height: True

                # -----------------------------------------------
                # KAYNAK DAĞILIMI
                # -----------------------------------------------

                MDCard:
                    orientation: "vertical"
                    adaptive_height: True
                    padding: dp(16)
                    spacing: dp(12)
                    radius: [dp(24), dp(24), dp(24), dp(24)]
                    elevation: 0
                    md_bg_color: app.theme_colors["card"]

                    MDLabel:
                        text: app.t("today_focus_distribution", app.translation_version)
                        font_style: "Subtitle1"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: app.theme_colors["text"]
                        adaptive_height: True

                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(8)

                        MDLabel:
                            text: app.t("study_plan", app.translation_version)
                            font_style: "Caption"
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["muted"]
                            adaptive_height: True

                        MDLabel:
                            text: root.study_plan_focus_text
                            halign: "right"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["primary"]
                            adaptive_height: True

                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(8)

                        MDLabel:
                            text: app.t("pomodoro", app.translation_version)
                            font_style: "Caption"
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["muted"]
                            adaptive_height: True

                        MDLabel:
                            text: root.regular_pomodoro_focus_text
                            halign: "right"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["orange"]
                            adaptive_height: True

                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(8)

                        MDLabel:
                            text: app.t("total", app.translation_version)
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["text"]
                            adaptive_height: True

                        MDLabel:
                            text: root.total_focus_text
                            halign: "right"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["green"]
                            adaptive_height: True

                # -----------------------------------------------
                # HEDEF
                # -----------------------------------------------

                MDCard:
                    orientation: "vertical"
                    adaptive_height: True
                    padding: dp(16)
                    spacing: dp(10)
                    radius: [dp(24), dp(24), dp(24), dp(24)]
                    elevation: 0
                    md_bg_color: app.theme_colors["card"]

                    MDLabel:
                        text: app.t("daily_goal", app.translation_version)
                        font_style: "Subtitle1"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: app.theme_colors["text"]
                        adaptive_height: True

                    MDLabel:
                        text: root.goal_detail_text
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: app.theme_colors["muted"]
                        adaptive_height: True

                    MDProgressBar:
                        value: root.goal_progress
                        size_hint_y: None
                        height: dp(10)
                        color: app.theme_colors["primary"]

                # -----------------------------------------------
                # HAFTALIK GÖRÜNÜM
                # -----------------------------------------------

                MDCard:
                    orientation: "vertical"
                    adaptive_height: True
                    padding: dp(16)
                    spacing: dp(12)
                    radius: [dp(24), dp(24), dp(24), dp(24)]
                    elevation: 0
                    md_bg_color: app.theme_colors["card"]

                    MDLabel:
                        text: app.t("weekly_overview", app.translation_version)
                        font_style: "Subtitle1"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: app.theme_colors["text"]
                        adaptive_height: True

                    Spinner:
                        text: root.selected_subject_name
                        values: root.subject_filter_values
                        size_hint_y: None
                        height: dp(44)
                        background_normal: ""
                        background_down: ""
                        background_color: app.theme_colors["surface_light"]
                        color: app.theme_colors["text"]
                        on_text: root.change_subject_filter(self.text)

                    MDLabel:
                        text: root.weekly_total_text
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: app.theme_colors["muted"]
                        adaptive_height: True

                    MDBoxLayout:
                        orientation: "vertical"
                        size_hint_y: None
                        height: dp(245)
                        spacing: dp(4)

                        # Sütunların üzerindeki dakika değerleri
                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(24)
                            spacing: 0

                            MDLabel:
                                text: root.weekly_value_texts[0]
                                halign: "center"
                                valign: "middle"

                                text_size: None, None
                                shorten: True

                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]

                            MDLabel:
                                text: root.weekly_value_texts[1]
                                halign: "center"
                                valign: "middle"

                                text_size: None, None
                                shorten: True

                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]

                            MDLabel:
                                text: root.weekly_value_texts[2]
                                halign: "center"
                                valign: "middle"

                                text_size: None, None
                                shorten: True

                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]

                            MDLabel:
                                text: root.weekly_value_texts[3]
                                halign: "center"
                                valign: "middle"

                                text_size: None, None
                                shorten: True

                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]

                            MDLabel:
                                text: root.weekly_value_texts[4]
                                halign: "center"
                                valign: "middle"

                                text_size: None, None
                                shorten: True

                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]

                            MDLabel:
                                text: root.weekly_value_texts[5]
                                halign: "center"
                                valign: "middle"

                                text_size: None, None
                                shorten: True

                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]

                            MDLabel:
                                text: root.weekly_value_texts[6]
                                halign: "center"
                                valign: "middle"

                                text_size: None, None
                                shorten: True

                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]

                        WeeklyBarChart:
                            id: weekly_bar_chart
                            labels: root.weekly_labels
                            values: root.weekly_values
                            bar_color: app.theme_colors["primary"]
                            empty_bar_color: app.theme_colors["surface_light"]
                            grid_color: app.theme_colors["card_border"]
                            text_color: app.theme_colors["muted"]
                            size_hint_y: None
                            height: dp(175)

                        # Gün isimleri
                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(28)
                            spacing: 0

                            MDLabel:
                                text: root.weekly_labels[0]
                                halign: "center"
                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]

                            MDLabel:
                                text: root.weekly_labels[1]
                                halign: "center"
                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]

                            MDLabel:
                                text: root.weekly_labels[2]
                                halign: "center"
                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]

                            MDLabel:
                                text: root.weekly_labels[3]
                                halign: "center"
                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]

                            MDLabel:
                                text: root.weekly_labels[4]
                                halign: "center"
                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]

                            MDLabel:
                                text: root.weekly_labels[5]
                                halign: "center"
                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]

                            MDLabel:
                                text: root.weekly_labels[6]
                                halign: "center"
                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: app.theme_colors["muted"]

                # -----------------------------------------------
                # DERS DAĞILIMI
                # -----------------------------------------------

                MDCard:
                    orientation: "vertical"
                    adaptive_height: True
                    padding: dp(16)
                    spacing: dp(12)
                    radius: [dp(24), dp(24), dp(24), dp(24)]
                    elevation: 0
                    md_bg_color: app.theme_colors["card"]

                    MDLabel:
                        text: app.t("subject_distribution", app.translation_version)
                        font_style: "Subtitle1"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: app.theme_colors["text"]
                        adaptive_height: True

                    MDLabel:
                        text: root.subject_total_text
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: app.theme_colors["muted"]
                        adaptive_height: True

                    MDLabel:
                        id: subject_empty
                        text: root.empty_subject_text
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: app.theme_colors["muted"]
                        adaptive_height: False
                        height: dp(34)

                    MDBoxLayout:
                        id: subject_list
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(8)

                # -----------------------------------------------
                # SON OTURUMLAR
                # -----------------------------------------------

                MDCard:
                    orientation: "vertical"
                    adaptive_height: True
                    padding: dp(16)
                    spacing: dp(12)
                    radius: [dp(24), dp(24), dp(24), dp(24)]
                    elevation: 0
                    md_bg_color: app.theme_colors["card"]

                    MDLabel:
                        text: app.t("today_recent_sessions", app.translation_version)
                        font_style: "Subtitle1"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: app.theme_colors["text"]
                        adaptive_height: True

                    MDLabel:
                        id: recent_empty
                        text: root.empty_recent_text
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: app.theme_colors["muted"]
                        adaptive_height: False
                        height: dp(42)

                    MDBoxLayout:
                        id: recent_list
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(8)