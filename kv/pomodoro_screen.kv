#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<PomodoroScreen>:
    md_bg_color: app.theme_colors["bg"]

    FloatLayout:

        # =====================================================
        # ANA POMODORO EKRANI
        # =====================================================

        MDBoxLayout:
            orientation: "vertical"
            size_hint: 1, 1
            pos_hint: {"x": 0, "y": 0}

            MDTopAppBar:
                anchor_title: "center"
                elevation: 0
                md_bg_color: app.theme_colors["bg"]
                specific_text_color: app.theme_colors["text"]
                size_hint_y: None
                height: dp(app.responsive(46, 54, 44, 64, 58))

                left_action_items:
                    [["menu", lambda x: app.toggle_navigation_drawer()]]

                right_action_items:
                    [["cog-outline", lambda x: root.open_settings()]]

            MDBoxLayout:
                orientation: "vertical"
                padding: dp(app.responsive(10, 14, 8, 28, 20)), dp(app.responsive(6, 10, 4, 16, 10)), dp(app.responsive(10, 14, 8, 28, 20)), dp(app.responsive(10, 20, 8, 28, 16))
                spacing: dp(app.responsive(8, 10, 6, 14, 10))

                MDLabel:
                    text: app.t("pomodoro", app.translation_version)
                    halign: "center"
                    bold: True
                    font_size: sp(app.typography("page_title", app.layout_profile))
                    theme_text_color: "Custom"
                    text_color: app.theme_colors["text"]
                    size_hint_y: None
                    height: dp(app.responsive(26, 34, 24, 44, 38))


                MDCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(app.responsive(390, 425, 335, 580, 505))
                    padding: (dp(app.responsive(10, 16, 8, 24, 20)), dp(app.responsive(18, 22, 14, 30, 24)), dp(app.responsive(10, 16, 8, 24, 20)), dp(app.responsive(10, 16, 8, 22, 18)))
                    spacing: dp(app.responsive(6, 8, 5, 10, 8))
                    radius: [dp(30), dp(30), dp(30), dp(30)]
                    elevation: 0
                    md_bg_color: app.theme_colors["card"]

                    MDLabel:
                        text: root.mode_text
                        halign: "center"
                        valign: "middle"
                        bold: True
                        font_size: sp(app.typography("section_title", app.layout_profile))
                        theme_text_color: "Custom"
                        text_color: root.mode_color
                        size_hint_y: None
                        height: dp(app.responsive(24, 30, 22, 42, 36))
                        text_size: self.width, self.height

                    Widget:
                        size_hint_y: None
                        height: dp(app.responsive(18, 20, 12, 28, 22))

                    AnchorLayout:
                        anchor_x: "center"
                        anchor_y: "center"
                        size_hint_y: None
                        height: dp(app.responsive(170, 220, 165, 350, 320))

                        FloatLayout:
                            size_hint: None, None
                            size: dp(app.responsive(170, 210, 155, 330, 300)), dp(app.responsive(170, 210, 155, 330, 300))

                            CircularProgress:
                                progress: root.progress
                                progress_color: root.mode_color
                                track_color: app.theme_colors["card_soft"]
                                line_width: dp(app.responsive(7, 8, 6, 12, 10))
                                size_hint: 1, 1
                                pos: self.parent.pos

                            MDBoxLayout:
                                orientation: "vertical"
                                size_hint: None, None
                                size: dp(app.responsive(130, 160, 120, 260, 230)), dp(app.responsive(60, 78, 56, 115, 100))
                                spacing: 0
                                pos_hint: {"center_x": 0.5, "center_y": 0.5}

                                MDLabel:
                                    text: root.timer_text
                                    halign: "center"
                                    bold: True
                                    font_size: sp(app.typography("timer", app.layout_profile))
                                    theme_text_color: "Custom"
                                    text_color: app.theme_colors["text"]

                                MDLabel:
                                    text: root.cycle_text
                                    halign: "center"
                                    font_size: sp(app.typography("cycle", app.layout_profile))
                                    theme_text_color: "Custom"
                                    text_color: app.theme_colors["muted"]

                    Widget:
                        size_hint_y: None
                        height: dp(app.responsive(12, 14, 8, 20, 16))
                    
                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(app.responsive(56, 68, 52, 94, 84))
                        spacing: dp(app.responsive(6, 12, 5, 20, 16))
                        padding: dp(app.responsive(6, 10, 4, 16, 12)), 0

                        Widget:

                        MDFloatingActionButton:
                            icon: "restore"
                            type: "small"
                            md_bg_color: app.theme_colors["card_soft"]
                            on_release: root.reset_timer()

                        MDFloatingActionButton:
                            icon: root.primary_action_icon
                            type: "standard" if app.is_phone else "large"
                            md_bg_color: root.mode_color
                            on_release: root.toggle_timer()

                        MDFloatingActionButton:
                            icon: "skip-next"
                            type: "small"
                            md_bg_color: app.theme_colors["card_soft"]
                            on_release: root.skip_session()

                        Widget:

                    MDBoxLayout:
                        orientation: "vertical"
                        size_hint_y: None
                        height: dp(app.responsive(64, 72, 60, 96, 84))
                        spacing: dp(4)

                        MDLabel:
                            text: root.status_text
                            halign: "center"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.theme_colors["orange"]
                            size_hint_y: None
                            height: dp(app.responsive(18, 22, 17, 30, 26))
                            font_size: sp(app.typography("status", app.layout_profile))
                            opacity: 1 if root.status_text else 0

                        MDRaisedButton:
                            text: app.t("stop_alarm", app.translation_version)
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(app.responsive(42, 46, 40, 54, 50))
                            opacity: 1 if app.alarm_active else 0
                            disabled: not app.alarm_active
                            md_bg_color: app.theme_colors["red"]
                            on_release: app.stop_alarm()

                Widget:
                    size_hint_y: 0.5

        # =====================================================
        # PANEL AÇIKKEN ARKA PLANI KARARTAN KATMAN
        # =====================================================

        Button:
            size_hint:
                (1, 1) if root.settings_panel_open else (None, None)

            size:
                root.size if root.settings_panel_open else (0, 0)

            pos:
                0, 0

            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0.48

            opacity:
                1 if root.settings_panel_open else 0

            disabled:
                not root.settings_panel_open

            on_release:
                root.close_settings()

        # =====================================================
        # SAĞDAN AÇILAN POMODORO AYAR PANELİ
        # =====================================================

        MDBoxLayout:
            id: pomodoro_settings_panel
            orientation: "vertical"
            size_hint: None, 1

            width: min(root.width * 0.86, dp(370))

            x: root.width - self.width if root.settings_panel_open else root.width
            y: 0

            padding: dp(18), dp(16), dp(18), dp(24)
            spacing: dp(12)

            disabled: not root.settings_panel_open
            opacity: 1 if root.settings_panel_open else 0

            canvas.before:
                Color:
                    rgba: app.sidebar_color

                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(26), 0, 0, dp(26)]

            MDBoxLayout:
                size_hint_y: None
                height: dp(48)
                spacing: dp(8)

                MDLabel:
                    text: app.t("pomodoro_settings", app.translation_version)
                    font_size: sp(app.typography("section_title", app.layout_profile))
                    bold: True
                    theme_text_color: "Custom"
                    text_color: app.theme_colors["text"] if app.theme_version >= 0 else (1, 1, 1, 1)

                MDIconButton:
                    icon: "close"
                    theme_icon_color: "Custom"
                    icon_color: app.theme_colors["soft"] if app.theme_version >= 0 else (1, 1, 1, 1)
                    on_release: root.close_settings()

            MDLabel:
                text: app.t("pomodoro_settings_description", app.translation_version)
                font_size: sp(app.typography("body_small", app.layout_profile))
                theme_text_color: "Custom"
                text_color: app.theme_colors["muted"] if app.theme_version >= 0 else (1, 1, 1, 1)
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width, None

            ScrollView:
                do_scroll_x: False
                bar_width: 0

                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(12)
                    padding: 0, dp(6), 0, dp(16)

                    MDTextField:
                        id: settings_focus_minutes
                        text: root.settings_focus_minutes
                        hint_text: app.t("focus_duration_minutes", app.translation_version)
                        helper_text_mode: "persistent"
                        input_filter: "int"
                        mode: "fill"
                        font_size: sp(app.typography("input", app.layout_profile))

                        size_hint_y: None
                        height: dp(68)

                        fill_color_normal: app.theme_colors["surface_light"] if app.dark_mode_enabled else app.theme_colors["input"]
                        fill_color_focus: app.theme_colors["card_soft"] if app.dark_mode_enabled else app.theme_colors["input"]

                        text_color_normal: app.theme_colors["text"] if app.dark_mode_enabled else app.theme_colors["input_text"]
                        text_color_focus: app.theme_colors["text"] if app.dark_mode_enabled else app.theme_colors["input_text"]

                        hint_text_color_normal: app.theme_colors["muted"] if app.theme_version >= 0 else (0.5, 0.5, 0.5, 1)
                        hint_text_color_focus: app.theme_colors["primary"] if app.theme_version >= 0 else (0.5, 0.5, 0.5, 1)

                        helper_text_color_normal: app.theme_colors["muted"] if app.theme_version >= 0 else (0.5, 0.5, 0.5, 1)
                        helper_text_color_focus: app.theme_colors["primary"] if app.theme_version >= 0 else (0.5, 0.5, 0.5, 1)

                        line_color_normal:
                            0, 0, 0, 0

                        line_color_focus: app.theme_colors["primary"] if app.theme_version >= 0 else (1, 1, 1, 1)

                    MDTextField:
                        id: settings_short_break_minutes
                        text: root.settings_short_break_minutes
                        hint_text: app.t("short_break_minutes", app.translation_version)
                        helper_text_mode: "persistent"
                        input_filter: "int"
                        mode: "fill"
                        font_size: sp(app.typography("input", app.layout_profile))

                        size_hint_y: None
                        height: dp(68)

                        fill_color_normal: app.theme_colors["surface_light"] if app.dark_mode_enabled else app.theme_colors["input"]
                        fill_color_focus: app.theme_colors["card_soft"] if app.dark_mode_enabled else app.theme_colors["input"]

                        text_color_normal: app.theme_colors["text"] if app.dark_mode_enabled else app.theme_colors["input_text"]
                        text_color_focus: app.theme_colors["text"] if app.dark_mode_enabled else app.theme_colors["input_text"]

                        hint_text_color_normal: app.theme_colors["muted"] if app.theme_version >= 0 else (0.5, 0.5, 0.5, 1)
                        hint_text_color_focus: app.theme_colors["primary"] if app.theme_version >= 0 else (0.5, 0.5, 0.5, 1)

                        helper_text_color_normal: app.theme_colors["muted"] if app.theme_version >= 0 else (0.5, 0.5, 0.5, 1)
                        helper_text_color_focus: app.theme_colors["primary"] if app.theme_version >= 0 else (0.5, 0.5, 0.5, 1)

                        line_color_normal:
                            0, 0, 0, 0

                        line_color_focus: app.theme_colors["primary"] if app.theme_version >= 0 else (1, 1, 1, 1)

                    MDTextField:
                        id: settings_long_break_minutes
                        text: root.settings_long_break_minutes
                        hint_text: app.t("long_break_minutes", app.translation_version)
                        helper_text_mode: "persistent"
                        input_filter: "int"
                        mode: "fill"
                        font_size: sp(app.typography("input", app.layout_profile))

                        size_hint_y: None
                        height: dp(68)

                        fill_color_normal: app.theme_colors["surface_light"] if app.dark_mode_enabled else app.theme_colors["input"]
                        fill_color_focus: app.theme_colors["card_soft"] if app.dark_mode_enabled else app.theme_colors["input"]

                        text_color_normal: app.theme_colors["text"] if app.dark_mode_enabled else app.theme_colors["input_text"]
                        text_color_focus: app.theme_colors["text"] if app.dark_mode_enabled else app.theme_colors["input_text"]

                        hint_text_color_normal: app.theme_colors["muted"] if app.theme_version >= 0 else (0.5, 0.5, 0.5, 1)
                        hint_text_color_focus: app.theme_colors["primary"] if app.theme_version >= 0 else (0.5, 0.5, 0.5, 1)

                        helper_text_color_normal: app.theme_colors["muted"] if app.theme_version >= 0 else (0.5, 0.5, 0.5, 1)
                        helper_text_color_focus: app.theme_colors["primary"] if app.theme_version >= 0 else (0.5, 0.5, 0.5, 1)

                        line_color_normal:
                            0, 0, 0, 0

                        line_color_focus: app.theme_colors["primary"] if app.theme_version >= 0 else (1, 1, 1, 1)

                    MDTextField:
                        id: settings_long_break_after
                        text: root.settings_long_break_after
                        hint_text: app.t("long_break_interval", app.translation_version)
                        helper_text_mode: "persistent"
                        input_filter: "int"
                        mode: "fill"
                        font_size: sp(app.typography("input", app.layout_profile))

                        size_hint_y: None
                        height: dp(68)

                        fill_color_normal: app.theme_colors["surface_light"] if app.dark_mode_enabled else app.theme_colors["input"]
                        fill_color_focus: app.theme_colors["card_soft"] if app.dark_mode_enabled else app.theme_colors["input"]

                        text_color_normal: app.theme_colors["text"] if app.dark_mode_enabled else app.theme_colors["input_text"]
                        text_color_focus: app.theme_colors["text"] if app.dark_mode_enabled else app.theme_colors["input_text"]

                        hint_text_color_normal: app.theme_colors["muted"] if app.theme_version >= 0 else (0.5, 0.5, 0.5, 1)
                        hint_text_color_focus: app.theme_colors["primary"] if app.theme_version >= 0 else (0.5, 0.5, 0.5, 1)

                        helper_text_color_normal: app.theme_colors["muted"] if app.theme_version >= 0 else (0.5, 0.5, 0.5, 1)
                        helper_text_color_focus: app.theme_colors["primary"] if app.theme_version >= 0 else (0.5, 0.5, 0.5, 1)

                        line_color_normal:
                            0, 0, 0, 0

                        line_color_focus: app.theme_colors["primary"] if app.theme_version >= 0 else (1, 1, 1, 1)

                    MDTextField:
                        id: settings_focus_count
                        text: root.settings_focus_count
                        hint_text: app.t("total_focus_cycles", app.translation_version)
                        helper_text: app.t("zero_for_unlimited_cycles", app.translation_version)
                        helper_text_mode: "persistent"
                        input_filter: "int"
                        mode: "fill"
                        font_size: sp(app.typography("input", app.layout_profile))

                        size_hint_y: None
                        height: dp(68)

                        fill_color_normal: app.theme_colors["surface_light"] if app.dark_mode_enabled else app.theme_colors["input"]
                        fill_color_focus: app.theme_colors["card_soft"] if app.dark_mode_enabled else app.theme_colors["input"]

                        text_color_normal: app.theme_colors["text"] if app.dark_mode_enabled else app.theme_colors["input_text"]
                        text_color_focus: app.theme_colors["text"] if app.dark_mode_enabled else app.theme_colors["input_text"]

                        hint_text_color_normal: app.theme_colors["muted"] if app.theme_version >= 0 else (0.5, 0.5, 0.5, 1)
                        hint_text_color_focus: app.theme_colors["primary"] if app.theme_version >= 0 else (0.5, 0.5, 0.5, 1)

                        helper_text_color_normal: app.theme_colors["muted"] if app.theme_version >= 0 else (0.5, 0.5, 0.5, 1)
                        helper_text_color_focus: app.theme_colors["primary"] if app.theme_version >= 0 else (0.5, 0.5, 0.5, 1)

                        line_color_normal:
                            0, 0, 0, 0

                        line_color_focus: app.theme_colors["primary"] if app.theme_version >= 0 else (1, 1, 1, 1)

            MDRaisedButton:
                text: app.t("save", app.translation_version)
                size_hint_x: 1
                size_hint_y: None
                height: dp(50)
                font_size: sp(app.typography("body", app.layout_profile))
                md_bg_color: app.theme_colors["primary"] if app.theme_version >= 0 else (0.5, 0.4, 0.9, 1)
                on_release: root.save_pomodoro_settings()