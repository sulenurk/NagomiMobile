#:import dp kivy.metrics.dp

<PomodoroScreen>:
    md_bg_color: 0.055, 0.047, 0.09, 1

    FloatLayout:

        # =====================================================
        # ANA POMODORO EKRANI
        # =====================================================

        MDBoxLayout:
            orientation: "vertical"
            size_hint: 1, 1
            pos_hint: {"x": 0, "y": 0}

            MDTopAppBar:
                anchor_title: "center"
                elevation: 0
                md_bg_color: 0.055, 0.047, 0.09, 1
                specific_text_color: 0.96, 0.94, 1, 1

                left_action_items:
                    [["menu", lambda x: app.toggle_navigation_drawer()]]

                right_action_items:
                    [["cog-outline", lambda x: root.open_settings()]]

            MDBoxLayout:
                orientation: "vertical"
                padding: dp(18), dp(12), dp(18), dp(24)
                spacing: dp(8)

                MDLabel:
                    text: app.t("regular_pomodoro")
                    halign: "center"
                    font_style: "H5"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: 0.96, 0.94, 1, 1
                    size_hint_y: None
                    height: dp(34)

                MDLabel:
                    text: app.t("pomodoro_subtitle")
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 0.68, 0.65, 0.78, 1
                    size_hint_y: None
                    height: dp(30)

                Widget:
                    size_hint_y: 0.25

                MDCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(485)
                    padding: dp(18), dp(20), dp(18), dp(20)
                    spacing: dp(8)
                    radius: [dp(30), dp(30), dp(30), dp(30)]
                    elevation: 0
                    md_bg_color: 0.105, 0.09, 0.16, 1

                    MDLabel:
                        text: root.mode_text
                        halign: "center"
                        font_style: "H6"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: root.mode_color
                        size_hint_y: None
                        height: dp(36)

                    FloatLayout:
                        size_hint_y: None
                        height: dp(305)

                        CircularProgress:
                            progress: root.progress
                            progress_color: root.mode_color
                            track_color: 0.18, 0.16, 0.25, 1
                            line_width: dp(11)

                            size_hint: None, None
                            size: dp(275), dp(275)

                            pos_hint:
                                {"center_x": 0.5, "center_y": 0.5}

                        MDBoxLayout:
                            orientation: "vertical"
                            size_hint: None, None
                            size: dp(220), dp(110)
                            spacing: dp(2)

                            pos_hint:
                                {"center_x": 0.5, "center_y": 0.5}

                            MDLabel:
                                text: root.timer_text
                                halign: "center"
                                font_style: "H2"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 0.98, 0.97, 1, 1

                            MDLabel:
                                text: root.cycle_text
                                halign: "center"
                                font_style: "Subtitle1"
                                theme_text_color: "Custom"
                                text_color: 0.68, 0.65, 0.78, 1

                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(76)
                        spacing: dp(16)
                        padding: dp(10), 0

                        Widget:

                        MDFloatingActionButton:
                            icon: "restore"
                            type: "small"
                            md_bg_color: 0.18, 0.16, 0.25, 1
                            on_release: root.reset_timer()

                        MDFloatingActionButton:
                            icon: root.primary_action_icon
                            type: "large"
                            md_bg_color: root.mode_color
                            on_release: root.toggle_timer()

                        MDFloatingActionButton:
                            icon: "skip-next"
                            type: "small"
                            md_bg_color: 0.18, 0.16, 0.25, 1
                            on_release: root.skip_session()

                        Widget:

                    MDLabel:
                        text: root.status_text
                        halign: "center"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: 0.95, 0.66, 0.35, 1
                        size_hint_y: None
                        height: dp(28)

                Widget:
                    size_hint_y: 0.75

        # =====================================================
        # PANEL AÇIKKEN ARKA PLANI KARARTAN KATMAN
        # =====================================================

        Button:
            size_hint:
                (1, 1) if root.settings_panel_open else (None, None)

            size:
                root.size if root.settings_panel_open else (0, 0)

            pos:
                0, 0

            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0.48

            opacity:
                1 if root.settings_panel_open else 0

            disabled:
                not root.settings_panel_open

            on_release:
                root.close_settings()

        # =====================================================
        # SAĞDAN AÇILAN POMODORO AYAR PANELİ
        # =====================================================

        MDCard:
            orientation: "vertical"
            size_hint: None, 1

            width:
                min(root.width * 0.86, dp(370))

            x:
                root.width - self.width \
                if root.settings_panel_open \
                else root.width

            y: 0

            padding: dp(18), dp(16), dp(18), dp(24)
            spacing: dp(12)

            radius:
                [dp(26), 0, 0, dp(26)]

            elevation:
                8 if root.settings_panel_open else 0

            md_bg_color:
                0.085, 0.073, 0.13, 1

            disabled:
                not root.settings_panel_open

            opacity:
                1 if root.settings_panel_open else 0

            MDBoxLayout:
                size_hint_y: None
                height: dp(48)
                spacing: dp(8)

                MDLabel:
                    text: app.t("pomodoro_settings")
                    font_style: "Subtitle1"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: 0.96, 0.94, 1, 1

                MDIconButton:
                    icon: "close"
                    theme_icon_color: "Custom"
                    icon_color: 0.78, 0.74, 0.86, 1
                    on_release: root.close_settings()

            MDLabel:
                text: app.t("pomodoro_settings_description")
                font_style: "Caption"
                theme_text_color: "Custom"
                text_color: 0.66, 0.62, 0.74, 1
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width, None

            ScrollView:
                do_scroll_x: False
                bar_width: 0

                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(12)
                    padding: 0, dp(6), 0, dp(16)

                    MDTextField:
                        id: settings_focus_minutes
                        text: root.settings_focus_minutes
                        hint_text: app.t("focus_duration_minutes")
                        helper_text_mode: "persistent"
                        input_filter: "int"
                        mode: "fill"

                        size_hint_y: None
                        height: dp(68)

                        fill_color_normal:
                            0.11, 0.095, 0.16, 1

                        fill_color_focus:
                            0.13, 0.11, 0.19, 1

                        text_color_normal:
                            0.96, 0.94, 1, 1

                        text_color_focus:
                            0.96, 0.94, 1, 1

                        hint_text_color_normal:
                            0.58, 0.54, 0.68, 1

                        hint_text_color_focus:
                            0.68, 0.60, 0.96, 1

                        helper_text_color_normal:
                            0.52, 0.49, 0.63, 1

                        helper_text_color_focus:
                            0.68, 0.60, 0.96, 1

                        line_color_normal:
                            0, 0, 0, 0

                        line_color_focus:
                            0.65, 0.55, 0.98, 1

                    MDTextField:
                        id: settings_short_break_minutes
                        text: root.settings_short_break_minutes
                        hint_text: app.t("short_break_minutes")
                        helper_text_mode: "persistent"
                        input_filter: "int"
                        mode: "fill"

                        size_hint_y: None
                        height: dp(68)

                        fill_color_normal:
                            0.11, 0.095, 0.16, 1

                        fill_color_focus:
                            0.13, 0.11, 0.19, 1

                        text_color_normal:
                            0.96, 0.94, 1, 1

                        text_color_focus:
                            0.96, 0.94, 1, 1

                        hint_text_color_normal:
                            0.58, 0.54, 0.68, 1

                        hint_text_color_focus:
                            0.68, 0.60, 0.96, 1

                        helper_text_color_normal:
                            0.52, 0.49, 0.63, 1

                        helper_text_color_focus:
                            0.68, 0.60, 0.96, 1

                        line_color_normal:
                            0, 0, 0, 0

                        line_color_focus:
                            0.65, 0.55, 0.98, 1

                    MDTextField:
                        id: settings_long_break_minutes
                        text: root.settings_long_break_minutes
                        hint_text: app.t("long_break_minutes")
                        helper_text_mode: "persistent"
                        input_filter: "int"
                        mode: "fill"

                        size_hint_y: None
                        height: dp(68)

                        fill_color_normal:
                            0.11, 0.095, 0.16, 1

                        fill_color_focus:
                            0.13, 0.11, 0.19, 1

                        text_color_normal:
                            0.96, 0.94, 1, 1

                        text_color_focus:
                            0.96, 0.94, 1, 1

                        hint_text_color_normal:
                            0.58, 0.54, 0.68, 1

                        hint_text_color_focus:
                            0.68, 0.60, 0.96, 1

                        helper_text_color_normal:
                            0.52, 0.49, 0.63, 1

                        helper_text_color_focus:
                            0.68, 0.60, 0.96, 1

                        line_color_normal:
                            0, 0, 0, 0

                        line_color_focus:
                            0.65, 0.55, 0.98, 1

                    MDTextField:
                        id: settings_long_break_after
                        text: root.settings_long_break_after
                        hint_text: app.t("long_break_interval")
                        helper_text_mode: "persistent"
                        input_filter: "int"
                        mode: "fill"

                        size_hint_y: None
                        height: dp(68)

                        fill_color_normal:
                            0.11, 0.095, 0.16, 1

                        fill_color_focus:
                            0.13, 0.11, 0.19, 1

                        text_color_normal:
                            0.96, 0.94, 1, 1

                        text_color_focus:
                            0.96, 0.94, 1, 1

                        hint_text_color_normal:
                            0.58, 0.54, 0.68, 1

                        hint_text_color_focus:
                            0.68, 0.60, 0.96, 1

                        helper_text_color_normal:
                            0.52, 0.49, 0.63, 1

                        helper_text_color_focus:
                            0.68, 0.60, 0.96, 1

                        line_color_normal:
                            0, 0, 0, 0

                        line_color_focus:
                            0.65, 0.55, 0.98, 1

                    MDTextField:
                        id: settings_focus_count
                        text: root.settings_focus_count
                        hint_text: app.t("total_focus_cycles")
                        helper_text: app.t("zero_for_unlimited_cycles")
                        helper_text_mode: "persistent"
                        input_filter: "int"
                        mode: "fill"

                        size_hint_y: None
                        height: dp(68)

                        fill_color_normal:
                            0.11, 0.095, 0.16, 1

                        fill_color_focus:
                            0.13, 0.11, 0.19, 1

                        text_color_normal:
                            0.96, 0.94, 1, 1

                        text_color_focus:
                            0.96, 0.94, 1, 1

                        hint_text_color_normal:
                            0.58, 0.54, 0.68, 1

                        hint_text_color_focus:
                            0.68, 0.60, 0.96, 1

                        helper_text_color_normal:
                            0.52, 0.49, 0.63, 1

                        helper_text_color_focus:
                            0.68, 0.60, 0.96, 1

                        line_color_normal:
                            0, 0, 0, 0

                        line_color_focus:
                            0.65, 0.55, 0.98, 1

            MDRaisedButton:
                text: app.t("save")
                size_hint_x: 1
                size_hint_y: None
                height: dp(50)
                md_bg_color: 0.60, 0.45, 0.96, 1
                on_release: root.save_pomodoro_settings()