#:import dp kivy.metrics.dp

MDNavigationLayout:

    ScreenManager:
        id: screen_manager

        PomodoroScreen:
            name: "pomodoro"

        FocusScreen:
            name: "focus"

        SubjectsScreen:
            name: "subjects"

        StudyPlanScreen:
            name: "study"

        StatisticsScreen:
            name: "statistics"

        SettingsScreen:
            name: "settings"

    MDNavigationDrawer:
        id: nav_drawer

        MDBoxLayout:
            orientation: "vertical"
            padding: dp(20)
            spacing: dp(8)
            md_bg_color: app.theme_colors["sidebar"]

            MDLabel:
                text: app.t("app_name", app.translation_version)
                font_style: "H5"
                halign: "center"
                bold: True
                theme_text_color: "Custom"
                text_color: app.theme_colors["text"]
                size_hint_y: None
                height: dp(90)

            MDFlatButton:
                text: app.t("pomodoro", app.translation_version)
                size_hint_x: 1
                theme_text_color: "Custom"
                text_color: app.theme_colors["primary"] if app.active_page == "pomodoro" else app.theme_colors["soft"]
                on_release: app.show_page("pomodoro")

            MDFlatButton:
                text: app.t("focus_timer", app.translation_version)
                size_hint_x: 1
                theme_text_color: "Custom"
                text_color: app.theme_colors["primary"] if app.active_page == "pomodoro" else app.theme_colors["soft"]
                on_release: app.show_page("focus")

            MDFlatButton:
                text: app.t("subjects", app.translation_version)
                size_hint_x: 1
                theme_text_color: "Custom"
                text_color: app.theme_colors["primary"] if app.active_page == "pomodoro" else app.theme_colors["soft"]
                on_release: app.show_page("subjects")

            MDFlatButton:
                text: app.t("study_plan", app.translation_version)
                size_hint_x: 1
                theme_text_color: "Custom"
                text_color: app.theme_colors["primary"] if app.active_page == "pomodoro" else app.theme_colors["soft"]
                on_release: app.show_page("study")

            MDFlatButton:
                text: app.t("statistics", app.translation_version)
                size_hint_x: 1
                theme_text_color: "Custom"
                text_color: app.theme_colors["primary"] if app.active_page == "pomodoro" else app.theme_colors["soft"]
                on_release: app.show_page("statistics")

            MDFlatButton:
                text: app.t("settings", app.translation_version)
                size_hint_x: 1
                theme_text_color: "Custom"
                text_color: app.theme_colors["primary"] if app.active_page == "pomodoro" else app.theme_colors["soft"]
                on_release: app.show_page("settings")

            MDSeparator:
                size_hint_y: None
                height: dp(1)
                color: app.theme_colors["card_border"]

            # -----------------------------------------------
            # ALARM
            # -----------------------------------------------

            MDBoxLayout:
                size_hint_y: None
                height: dp(52)
                spacing: dp(8)

                MDIcon:
                    icon: "bell-outline"
                    size_hint_x: None
                    width: dp(34)
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: app.theme_colors["muted"]

                MDLabel:
                    text: app.t("alarm", app.translation_version)
                    font_style: "Subtitle2"
                    theme_text_color: "Custom"
                    text_color: app.theme_colors["text"]

                AnchorLayout:
                    size_hint_x: None
                    width: dp(72)
                    padding: 0, 0, dp(16), 0
                    anchor_x: "center"
                    anchor_y: "center"

                    NagomiSwitch:
                        id: sound_switch
                        state: "down" if app.sound_enabled else "normal"
                        on_state: app.set_sound_enabled(self.state == "down")

            # -----------------------------------------------
            # DARK / LIGHT MODE
            # -----------------------------------------------

            MDBoxLayout:
                size_hint_y: None
                height: dp(52)
                spacing: dp(8)

                MDIcon:
                    icon: "weather-night" if app.dark_mode_enabled else "white-balance-sunny"
                    size_hint_x: None
                    width: dp(34)
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: app.theme_colors["muted"]

                MDLabel:
                    text: app.t("dark_mode", app.translation_version) if app.dark_mode_enabled else app.t("light_mode", app.translation_version)
                    font_style: "Subtitle2"
                    theme_text_color: "Custom"
                    text_color: app.theme_colors["text"]

                AnchorLayout:
                    size_hint_x: None
                    width: dp(72)
                    padding: 0, 0, dp(16), 0
                    anchor_x: "center"
                    anchor_y: "center"

                    NagomiSwitch:
                        id: dark_mode_switch
                        state: "down" if app.dark_mode_enabled else "normal"
                        on_state: app.set_dark_mode(self.state == "down")

            # Bu Widget dil bölümünü drawer'ın en altına iter.
            Widget:

            MDSeparator:
                size_hint_y: None
                height: dp(1)
                color: app.theme_colors["card_border"]

            # -----------------------------------------------
            # DİL
            # -----------------------------------------------

            MDBoxLayout:
                size_hint_y: None
                height: dp(34)
                spacing: dp(8)

                MDIcon:
                    icon: "translate"
                    size_hint_x: None
                    width: dp(34)
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 0.72, 0.68, 0.84, 1

                MDLabel:
                    text: app.t("language", app.translation_version)
                    font_style: "Subtitle2"
                    theme_text_color: "Custom"
                    text_color: 0.90, 0.87, 0.98, 1

            Spinner:
                text: app.selected_language_name
                values: ["English", "Türkçe", "Deutsch", "Français", "Español", "Português", "简体中文", "日本語"]
                size_hint_y: None
                height: dp(46)
                background_normal: ""
                background_down: ""
                background_color: app.theme_colors["surface_light"]
                color: app.theme_colors["text"]
                on_text: app.set_language_by_name(self.text)
